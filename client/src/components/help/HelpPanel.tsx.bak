import React, { useState } from 'react';
import {
    Sheet,
    SheetContent,
    SheetDescription,
    SheetHeader,
    SheetTitle,
    SheetTrigger,
} from '@/components/ui/sheet';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/ui/accordion';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Badge } from '@/components/ui/badge';
import { helpSections, glossary } from '@/lib/help-content';
import { HelpCircle, BookOpen, MessageCircleQuestion, Wrench, Search, Lightbulb } from 'lucide-react';
import { cn } from '@/lib/utils';

/**
 * 帮助面板组件
 * 侧边栏展示完整的帮助文档、FAQ和术语表
 */
export function HelpPanel() {
    const [searchQuery, setSearchQuery] = useState('');
    const [open, setOpen] = useState(false);

    // 搜索过滤
    const filteredSections = helpSections.filter(section =>
        section.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
        section.content.toLowerCase().includes(searchQuery.toLowerCase())
    );

    const categoryIcons = {
        'getting-started': Lightbulb,
        'features': BookOpen,
        'faq': MessageCircleQuestion,
        'troubleshooting': Wrench
    };

    const categoryLabels = {
        'getting-started': '快速开始',
        'features': '功能说明',
        'faq': '常见问题',
        'troubleshooting': '疑难解答'
    };

    const categoryColors = {
        'getting-started': 'bg-emerald-100 text-emerald-700 border-emerald-200',
        'features': 'bg-blue-100 text-blue-700 border-blue-200',
        'faq': 'bg-purple-100 text-purple-700 border-purple-200',
        'troubleshooting': 'bg-amber-100 text-amber-700 border-amber-200'
    };

    return (
        <Sheet open={open} onOpenChange={setOpen}>
            <SheetTrigger asChild>
                <Button variant="outline" size="sm" className="gap-2">
                    <HelpCircle className="w-4 h-4" />
                    <span className="hidden md:inline">帮助中心</span>
                </Button>
            </SheetTrigger>
            <SheetContent side="right" className="w-full sm:w-[540px] sm:max-w-[540px] p-0">
                <SheetHeader className="px-6 pt-6 pb-4 border-b">
                    <SheetTitle className="flex items-center gap-2 text-xl">
                        <BookOpen className="w-5 h-5" />
                        帮助中心
                    </SheetTitle>
                    <SheetDescription>
                        查找操作指南、常见问题和疑难解答
                    </SheetDescription>
                </SheetHeader>

                <div className="px-6 py-4 border-b bg-muted/30">
                    <div className="relative">
                        <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
                        <Input
                            placeholder="搜索帮助内容..."
                            value={searchQuery}
                            onChange={(e) => setSearchQuery(e.target.value)}
                            className="pl-9"
                        />
                    </div>
                </div>

                <Tabs defaultValue="help" className="flex-1 flex flex-col">
                    <TabsList className="mx-6 mt-4 grid w-auto grid-cols-2 self-start">
                        <TabsTrigger value="help">帮助文档</TabsTrigger>
                        <TabsTrigger value="glossary">术语表</TabsTrigger>
                    </TabsList>

                    <TabsContent value="help" className="flex-1 mt-0">
                        <ScrollArea className="h-[calc(100vh-260px)]">
                            <div className="px-6 py-4 space-y-6">
                                {searchQuery ? (
                                    // 搜索结果
                                    filteredSections.length > 0 ? (
                                        <div className="space-y-4">
                                            <p className="text-sm text-muted-foreground">
                                                找到 {filteredSections.length} 个相关结果
                                            </p>
                                            {filteredSections.map(section => {
                                                const Icon = categoryIcons[section.category];
                                                return (
                                                    <div key={section.id} className="border rounded-lg p-4 space-y-2 hover:border-primary/50 transition-colors">
                                                        <div className="flex items-start justify-between gap-2">
                                                            <h4 className="font-medium">{section.title}</h4>
                                                            <Badge variant="outline" className={cn("shrink-0 text-xs", categoryColors[section.category])}>
                                                                <Icon className="w-3 h-3 mr-1" />
                                                                {categoryLabels[section.category]}
                                                            </Badge>
                                                        </div>
                                                        <div className="text-sm text-muted-foreground whitespace-pre-line line-clamp-4">
                                                            {section.content}
                                                        </div>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    ) : (
                                        <div className="text-center py-12">
                                            <Search className="w-12 h-12 mx-auto text-muted-foreground/50 mb-3" />
                                            <p className="text-muted-foreground">未找到相关内容</p>
                                            <p className="text-sm text-muted-foreground/70 mt-1">试试其他关键词</p>
                                        </div>
                                    )
                                ) : (
                                    // 按类别显示
                                    Object.entries(categoryLabels).map(([category, label]) => {
                                        const sections = helpSections.filter(s => s.category === category);
                                        const Icon = categoryIcons[category as keyof typeof categoryIcons];

                                        return (
                                            <div key={category} className="space-y-3">
                                                <div className="flex items-center gap-2 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
                                                    <Icon className="w-4 h-4" />
                                                    {label}
                                                </div>
                                                <Accordion type="single" collapsible className="space-y-2">
                                                    {sections.map(section => (
                                                        <AccordionItem
                                                            key={section.id}
                                                            value={section.id}
                                                            className="border rounded-lg px-4 data-[state=open]:bg-muted/30"
                                                        >
                                                            <AccordionTrigger className="hover:no-underline py-3">
                                                                <span className="text-left font-medium">{section.title}</span>
                                                            </AccordionTrigger>
                                                            <AccordionContent className="pb-4 pt-2">
                                                                <div className="text-sm text-muted-foreground whitespace-pre-line leading-relaxed">
                                                                    {section.content}
                                                                </div>
                                                            </AccordionContent>
                                                        </AccordionItem>
                                                    ))}
                                                </Accordion>
                                            </div>
                                        );
                                    })
                                )}
                            </div>
                        </ScrollArea>
                    </TabsContent>

                    <TabsContent value="glossary" className="flex-1 mt-0">
                        <ScrollArea className="h-[calc(100vh-260px)]">
                            <div className="px-6 py-4 space-y-3">
                                <div className="text-sm text-muted-foreground mb-4">
                                    这里是一些常用术语的简单解释
                                </div>
                                {Object.entries(glossary).map(([term, definition]) => (
                                    <div key={term} className="border-l-2 border-primary/50 pl-4 py-2 hover:border-primary transition-colors">
                                        <dt className="font-medium text-sm mb-1">{term}</dt>
                                        <dd className="text-sm text-muted-foreground leading-relaxed">{definition}</dd>
                                    </div>
                                ))}
                            </div>
                        </ScrollArea>
                    </TabsContent>
                </Tabs>

                <div className="px-6 border-t bg-muted/20">
                    <div className="text-xs text-muted-foreground text-center">
                        <p>还有问题？</p>
                        <p className="mt-1">
                            联系技术支持：<a href="mailto:zyy.im@outlook.com" className="text-primary hover:underline">zyy.im@outlook.com</a>
                        </p>
                    </div>
                </div>
            </SheetContent>
        </Sheet>
    );
}
