        "exceljs": "^4.4.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.8.0",
        "@tarojs/cli": "3.6.23",
        "@tarojs/webpack5-runner": "3.6.23",
        "@types/react": "^18.0.0",
        "@types/webpack-env": "^1.13.6",
        "@typescript-eslint/eslint-plugin": "^5.20.0",
        "@typescript-eslint/parser": "^5.20.0",
        "babel-preset-taro": "3.6.23",
        "eslint": "^8.12.0",
